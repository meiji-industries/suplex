{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "bin": {
    "forge": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "drizzle",
    "README.md",
    "components.json"
  ],
  "engines": {
    "node": "26.7.0"
  },
  "scripts": {
    "forge": "tsx src/cli.ts",
    "build": "tsc && vite build",
    "dev": "tsx src/cli.ts start --foreground",
    "migration:new": "tsx scripts/create-migration.ts",
    "smoke": "tsx scripts/smoke.mts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "check:full": "pnpm run check && pnpm run test:engine && pnpm run test:browser",
    "test": "vitest run --project unit",
    "test:engine": "vitest run --project engine",
    "test:governance-real": "vitest run --project real tests/plan-governance.real.test.ts",
    "verify-ticket-07": "pnpm run test:governance-real",
    "test:browser": "pnpm run build && vitest run --config vitest.browser.config.ts",
    "verify": "pnpm run check:full",
    "test:all": "pnpm run check:full",
    "test:release:lead": "pnpm run build && vitest run tests/codex-lead.real.test.ts --reporter=dot"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cookie": "^11.1.2",
    "@fastify/type-provider-zod": "^1.0.0",
    "@pierre/diffs": "^1.3.5",
    "@pierre/trees": "1.0.0-beta.6",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "lucide-react": "^1.31.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/middie": "^9.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "playwright": "^1.57.0",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
