{
  "contract": "tasks.TaskAgentsBatchQuerySchema",
  "case": "overlong_string",
  "input": {
    "taskId": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  },
  "expected": {
    "accepted": false,
    "error": [
      {
        "origin": "string",
        "code": "too_big",
        "maximum": 256,
        "inclusive": true,
        "path": [
          "taskId"
        ],
        "message": "Too big: expected string to have <=256 characters"
      }
    ]
  }
}
