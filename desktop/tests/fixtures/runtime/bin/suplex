#!/usr/bin/env python3
"""Test-only native CLI double for desktop install and process supervision."""

import json
import os
import signal
import sys
import time
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

STAGES = [
    {"name": "prerequisites", "title": "Check this Mac"},
    {"name": "developer-tools", "title": "Set up Git"},
    {"name": "herdr", "title": "Install Herdr terminals"},
    {"name": "data", "title": "Prepare Suplex data"},
    {"name": "complete", "title": "Finish"},
]
data = Path(os.environ.get("SUPLEX_DATA_ROOT", "."))


def read(name, default):
    try:
        return json.loads((data / name).read_text())
    except (OSError, ValueError):
        return default


def frame(value):
    print(json.dumps(value), flush=True)
    sys.exit(0 if value.get("ok") else 1)


args = sys.argv[1:]
if args == ["install", "--manifest"]:
    print(json.dumps({"protocolVersion": 1, "stages": STAGES}), flush=True)
elif len(args) == 4 and args[:2] == ["install", "--stage"] and args[3] == "--json":
    stage = args[2]
    known = next((entry for entry in STAGES if entry["name"] == stage), None)
    if known is None:
        sys.exit(f"unknown stage: {stage}")
    settings = read("fixture.json", {})
    done = read("fixture-stages.json", [])
    data.mkdir(parents=True, exist_ok=True)
    print(known["title"], file=sys.stderr, flush=True)
    if stage in done:
        frame({"ok": True, "stage": stage, "skipped": True, "reason": "already done"})
    if stage == settings.get("failStage"):
        print(f"{stage} could not finish", file=sys.stderr, flush=True)
        frame({"ok": False, "stage": stage, "reason": settings.get("reason", f"The {stage} step failed."), "remedy": settings.get("remedy", "Fix it and retry.")})
    for word in ("checking", "working", "finished"):
        print(f"{stage}: {word}", file=sys.stderr, flush=True)
    time.sleep(settings.get("delayMs", 0) / 1000)
    (data / "fixture-stages.json").write_text(json.dumps([*done, stage]))
    frame({"ok": True, "stage": stage, "skipped": False})
elif args == ["start", "--foreground"]:
    time.sleep(read("fixture.json", {}).get("startDelayMs", 0) / 1000)
    port = int(os.environ.get("SUPLEX_PORT", "4111"))

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"ok" if self.path == "/health" else b"<p>Suplex fixture</p>")

        def log_message(self, *_args):
            pass

    server = HTTPServer(("127.0.0.1", port), Handler)
    for name in (signal.SIGTERM, signal.SIGINT):
        signal.signal(name, lambda *_args: sys.exit(0))
    print(f"fixture native runtime listening on {port} (data {data})", flush=True)
    try:
        server.serve_forever()
    finally:
        server.server_close()
else:
    sys.exit(f"unknown command: {' '.join(args)}")
