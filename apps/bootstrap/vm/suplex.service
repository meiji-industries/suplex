[Unit]
Description=Suplex host
After=network-online.target tailscaled.service herdr.service
Wants=network-online.target herdr.service

[Service]
User=suplex
Group=suplex
WorkingDirectory=/home/suplex
Environment=HOME=/home/suplex
Environment=PATH=/home/suplex/.local/bin:/home/suplex/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/suplex/.local/bin/suplex up --foreground
Restart=always
RestartSec=5
# Agent turns run in their own process groups and outlive a restart; Suplex observes them on start.
# The supervisor stops `suplex serve` on SIGTERM.
KillMode=process
NoNewPrivileges=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
