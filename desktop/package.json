{
  "name": "suplex-desktop",
  "productName": "Suplex",
  "private": true,
  "version": "0.6.0",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/connect.html dist/src/ && mkdir -p dist/src/pages && cp src/pages/* dist/src/pages/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "sh scripts/dev.sh",
    "dist": "sh ../scripts/bundle-runtime.sh && pnpm build && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "dist:signed": "op run --env-file signing.env -- scripts/dist-signed.sh",
    "verify:signed": "spctl --assess --type execute -vv release/${SUPLEX_DESKTOP_ARCH:-arm64}/mac*/Suplex.app && xcrun stapler validate release/${SUPLEX_DESKTOP_ARCH:-arm64}/Suplex-*.dmg"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  }
}
