{
  "name": "suplex",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "26.7.0"
  },
  "scripts": {
    "suplex": "sh scripts/suplex.sh",
    "build": "sh scripts/build.sh",
    "dev": "tsx scripts/dev.ts",
    "migration:new": "tsx scripts/create-migration.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:rust",
    "check:full": "pnpm run check && pnpm run test:browser",
    "test": "vitest run --project unit",
    "test:guarded": "env -u RUSTUP_TOOLCHAIN cargo run --quiet --manifest-path rust/Cargo.toml --example guarded-tests --",
    "test:real": "vitest run --project real",
    "test:packaged": "vitest run --project packaged",
    "test:browser": "pnpm exec vite build && env -u RUSTUP_TOOLCHAIN cargo build --manifest-path rust/Cargo.toml --bin suplex --features github-test-endpoint && vitest run --config vitest.browser.config.ts",
    "verify": "pnpm run check:full",
    "test:all": "pnpm run check:full",
    "desktop:dev": "pnpm --filter suplex-desktop dev",
    "desktop:dist": "pnpm --filter suplex-desktop dist",
    "desktop:build": "pnpm --filter suplex-desktop build",
    "desktop:typecheck": "pnpm --filter suplex-desktop typecheck",
    "desktop:test": "vitest run --project unit desktop/tests",
    "desktop:dist:signed": "pnpm --filter suplex-desktop dist:signed",
    "desktop:publish": "bash scripts/publish-desktop-release.sh",
    "dev:watch": "tsx scripts/dev.ts --watch",
    "test:rust": "env -u RUSTUP_TOOLCHAIN RUST_TEST_THREADS=4 cargo test --manifest-path rust/Cargo.toml --all-targets"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@pierre/diffs": "^1.4.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@shadcn/react": "^0.3.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-query": "^5.103.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.276",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "lucide-react": "^1.31.0",
    "motion": "^12.43.0",
    "nanoid": "^6.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "happy-dom": "^20.14.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.57.0",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
