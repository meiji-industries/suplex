{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Suplex",
  "mainBinaryName": "Suplex",
  "version": "../package.json",
  "identifier": "dev.suplex.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'",
      "capabilities": ["setup", "unavailable"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "category": "DeveloperTool",
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "dmg": {
        "background": "../build/background.png",
        "windowSize": { "width": 540, "height": 380 },
        "appPosition": { "x": 130, "y": 220 },
        "applicationFolderPosition": { "x": 410, "y": 220 }
      }
    }
  },
  "plugins": {
    "updater": { "pubkey": "", "endpoints": [], "requireSignedVersion": true },
    "deep-link": { "desktop": { "schemes": ["suplex"] } }
  }
}
