{
  "contract": "projects.ProfileBodySchema",
  "case": "empty_model",
  "input": {
    "provider": "codex",
    "model": "  ",
    "reasoningLevel": "high",
    "serviceTier": "priority",
    "name": "Profile",
    "role": "worker",
