{
  "contract": "common.ExpectedRevisionBodySchema",
  "case": "large_hex_string_revision",
  "input": {
    "expectedRevision": "0x10000000000000000"
  },
  "expected": {
    "accepted": false,
    "error": [
      {
        "code": "too_big",
        "maximum": 9007199254740991,
        "note": "Integers must be within the safe integer range.",
        "origin": "int",
        "inclusive": true,
        "path": [
          "expectedRevision"
        ],
        "message": "Too big: expected int to be <=9007199254740991"
      },
      {
        "origin": "number",
        "code": "too_big",
        "maximum": 9007199254740991,
        "inclusive": true,
        "path": [
          "expectedRevision"
        ],
        "message": "Too big: expected number to be <=9007199254740991"
      }
    ]
  }
}
