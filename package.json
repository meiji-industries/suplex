{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "forge": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "components.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "forge": "tsx src/cli.ts",
    "build": "tsc && vite build",
    "dev": "tsx src/cli.ts start --foreground",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/app.test.ts tests/config.test.ts tests/database.test.ts tests/health.test.ts tests/process-manager.test.ts tests/redaction.test.ts tests/runtime.test.ts tests/setup.test.ts tests/temporal.integration.test.ts",
    "test:browser": "npm run build && tsx --test tests/health.browser.test.ts",
    "test:all": "npm run typecheck && npm test && npm run test:browser"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@temporalio/client": "^1.14.0",
    "@temporalio/proto": "^1.22.0",
    "@temporalio/worker": "^1.14.0",
    "@temporalio/workflow": "^1.14.0",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.6.1",
    "long": "^5.2.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.57.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
