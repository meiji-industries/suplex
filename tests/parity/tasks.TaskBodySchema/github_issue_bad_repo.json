{
  "contract": "tasks.TaskBodySchema",
  "case": "github_issue_bad_repo",
  "input": {
    "projectId": "project",
    "title": "  Build  ",
    "idempotencyKey": "task-0001",
    "issue": {
      "kind": "github",
      "repository": "bad",
      "number": 12,
      "id": "123",
      "key": "GH-12",
      "title": "Issue",
      "url": "https://github.com/team/repo/issues/12"
    }
  },
  "expected": {
    "accepted": false,
    "error": [
      {
        "origin": "string",
        "code": "invalid_format",
        "format": "regex",
        "pattern": "/^[\\w.-]+\\/[\\w.-]+$/",
        "path": [
          "issue",
          "repository"
        ],
        "message": "Invalid string: must match pattern /^[\\w.-]+\\/[\\w.-]+$/"
      },
      {
        "code": "custom",
        "message": "Issue URL must match its tracker identity",
        "path": [
          "issue",
          "url"
        ]
      }
    ]
  }
}
