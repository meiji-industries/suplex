{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.6",
  "bin": {
    "forge": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "drizzle",
    "README.md",
    "components.json"
  ],
  "engines": {
    "node": "26.7.0"
  },
  "scripts": {
    "forge": "tsx src/cli.ts",
    "build": "tsc && vite build",
    "dev": "tsx src/cli.ts start --foreground",
    "dev:temporal": "tsx scripts/compose-temporal.ts up",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/temporal.integration.test.ts' --exclude 'tests/**/*.browser.test.ts'",
    "test:temporal": "vitest run tests/temporal.integration.test.ts",
    "test:browser": "pnpm run build && vitest run --config vitest.browser.config.ts",
    "test:all": "pnpm run typecheck && pnpm run test && pnpm run test:temporal && pnpm run test:browser"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cookie": "^11.1.2",
    "@fastify/type-provider-zod": "^1.0.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@temporalio/activity": "^1.22.0",
    "@temporalio/client": "^1.14.0",
    "@temporalio/proto": "^1.22.0",
    "@temporalio/worker": "^1.14.0",
    "@temporalio/workflow": "^1.14.0",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "long": "^5.2.3",
    "lucide-react": "^1.31.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.57.0",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
