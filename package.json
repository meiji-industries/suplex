{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "bin": {
    "forge": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "drizzle",
    "README.md",
    "components.json"
  ],
  "engines": {
    "node": "26.7.0"
  },
  "scripts": {
    "forge": "tsx src/cli.ts",
    "build": "tsc && vite build",
    "dev": "tsx src/cli.ts start --foreground",
    "migration:new": "tsx scripts/create-migration.ts",
    "smoke": "tsx scripts/probe-opencode-delivery.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "check:full": "pnpm run check && pnpm run test:browser",
    "test": "vitest run --project unit",
    "test:browser": "pnpm run build && vitest run --config vitest.browser.config.ts",
    "verify": "pnpm run check:full",
    "test:all": "pnpm run check:full",
    "desktop:dev": "pnpm --filter forge-desktop dev",
    "desktop:dist": "pnpm --filter forge-desktop dist",
    "desktop:build": "pnpm --filter forge-desktop build",
    "desktop:typecheck": "pnpm --filter forge-desktop typecheck",
    "desktop:test": "vitest run --project unit desktop/tests"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/type-provider-zod": "^1.0.0",
    "@fastify/websocket": "11.3.0",
    "@pierre/diffs": "^1.4.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@shadcn/react": "^0.3.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.276",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "lucide-react": "^1.31.0",
    "motion": "^12.43.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "3.8.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/middie": "^9.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "playwright": "^1.57.0",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "ws": "8.21.3"
  }
}
