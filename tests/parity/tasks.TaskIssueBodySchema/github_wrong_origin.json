{
  "contract": "tasks.TaskIssueBodySchema",
  "case": "github_wrong_origin",
  "input": {
    "issue": {
      "kind": "github",
      "repository": "team/repo",
      "number": 12,
      "id": "123",
      "key": "GH-12",
      "title": "Issue",
      "url": "https://example.com/x"
    }
  },
  "expected": {
    "accepted": false,
    "error": [
      {
        "code": "custom",
        "path": [
          "issue",
          "url"
        ],
        "message": "Invalid input"
      },
      {
        "code": "custom",
        "message": "Issue URL must match its tracker identity",
        "path": [
          "issue",
          "url"
        ]
      }
    ]
  }
}
