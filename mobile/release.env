# Loaded by `mise run release:mobile` through `op run`. Values live in the Suplex vault; nothing secret is in this file.
# App Store Connect API key with Admin access: signs the iOS app and uploads it to TestFlight.
APPLE_API_KEY=op://Suplex/oelxbz3t7ms6tdn7otitj4f7tu/APPLE_API_KEY
APPLE_API_ISSUER=op://Suplex/oelxbz3t7ms6tdn7otitj4f7tu/APPLE_API_ISSUER
APPLE_API_PRIVATE_KEY=op://Suplex/oelxbz3t7ms6tdn7otitj4f7tu/APPLE_API_PRIVATE_KEY
# The Play upload key: a base64 PKCS12 keystore with the alias "upload".
ANDROID_UPLOAD_KEYSTORE=op://Suplex/oelxbz3t7ms6tdn7otitj4f7tu/ANDROID_UPLOAD_KEYSTORE
ANDROID_UPLOAD_KEY_PASSWORD=op://Suplex/oelxbz3t7ms6tdn7otitj4f7tu/ANDROID_UPLOAD_KEY_PASSWORD
# Google Cloud service account key with release access to sh.suplex.mobile in the Play Console.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=op://Suplex/oelxbz3t7ms6tdn7otitj4f7tu/GOOGLE_PLAY_SERVICE_ACCOUNT_JSON
