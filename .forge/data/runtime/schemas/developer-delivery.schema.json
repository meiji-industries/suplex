{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "delivery"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "completed",
              "incomplete",
              "not_completed",
              "blocked",
              "not_applicable_locally"
            ]
          },
          "filesChanged": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commandsRun": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "testResults": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "number",
          "status",
          "filesChanged",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "authorizedStepsNotCompleted": {
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "resultCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "resultTree": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "dirtyState": {
      "type": "string",
      "enum": [
        "clean",
        "dirty"
      ]
    },
    "blocker": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "objections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "findingId": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["findingId", "reason"],
        "additionalProperties": false
      },
      "default": []
    },
    "visualEvidence": {
      "type": "object",
      "properties": {
        "captured": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "captures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "caption": {
                "type": "string",
                "maxLength": 500
              },
              "viewport": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  },
                  "deviceScaleFactor": {
                    "type": "number",
                    "minimum": 0.25,
                    "maximum": 8
                  }
                },
                "required": [
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              "capturedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "captured"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "summary",
    "steps",
    "authorizedStepsNotCompleted",
    "resultCommit",
    "resultTree",
    "dirtyState",
    "blocker"
  ],
  "additionalProperties": false
}
