{
  "name": "suplex-desktop",
  "productName": "Suplex",
  "private": true,
  "version": "1.13.0",
  "scripts": {
    "build": "env -u RUSTUP_TOOLCHAIN cargo build --manifest-path src-tauri/Cargo.toml --release",
    "typecheck": "env -u RUSTUP_TOOLCHAIN cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "test": "env -u RUSTUP_TOOLCHAIN cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "test:native": "sh scripts/test-native.sh",
    "test:packaged": "sh scripts/test-packaged.sh",
    "dev": "node scripts/dev.mjs",
    "dist": "sh scripts/dist.sh",
    "dist:signed": "op run --env-file signing.env -- sh scripts/dist-signed.sh",
    "verify:release": "sh scripts/verify-release.sh"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1"
  }
}
