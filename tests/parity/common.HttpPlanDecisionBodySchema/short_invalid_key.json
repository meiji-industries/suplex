{
  "contract": "common.HttpPlanDecisionBodySchema",
  "case": "short_invalid_key",
  "input": {
    "note": "Yes",
    "idempotencyKey": "bad key"
  },
  "expected": {
    "accepted": false,
    "error": [
      {
        "origin": "string",
        "code": "too_small",
        "minimum": 8,
        "inclusive": true,
        "path": [
          "idempotencyKey"
        ],
        "message": "Too small: expected string to have >=8 characters"
      },
      {
        "origin": "string",
        "code": "invalid_format",
        "format": "regex",
        "pattern": "/^[A-Za-z0-9][A-Za-z0-9._:-]*$/",
        "path": [
          "idempotencyKey"
        ],
        "message": "Invalid string: must match pattern /^[A-Za-z0-9][A-Za-z0-9._:-]*$/"
      }
    ]
  }
}
