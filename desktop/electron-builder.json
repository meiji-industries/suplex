{
  "appId": "dev.forge.desktop",
  "productName": "Forge",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/src/**"
  ],
  "beforeBuild": "build/before-build.js",
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "arm64"
        ]
      },
      {
        "target": "zip",
        "arch": [
          "arm64"
        ]
      }
    ],
    "hardenedRuntime": false,
    "notarize": false,
    "category": "public.app-category.developer-tools"
  }
}
